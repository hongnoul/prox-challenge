  "troubleshootingPaths": [
    {
      "id": "troubleshoot-wire-porosity",
      "symptom": "wire-weld porosity",
      "summary": "Process-aware porosity checks ordered from setup to technique.",
      "startNodeId": "porosity-process",
      "nodes": [
        {
          "id": "porosity-process",
          "kind": "question",
          "text": "Are you using gas-shielded MIG or self-shielded flux-core?",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {
            "mig": "porosity-polarity",
            "flux-core": "porosity-polarity"
          }
        },
        {
          "id": "porosity-polarity",
          "kind": "check",
          "text": "Verify the polarity for the selected process before changing technique.",
          "evidenceIds": [
            "ev-wire-porosity-p37",
            "ev-mig-dcep-p14",
            "ev-flux-dcen-p13"
          ],
          "next": {
            "correct": "porosity-gas",
            "incorrect": "porosity-fix-polarity"
          }
        },
        {
          "id": "porosity-fix-polarity",
          "kind": "resolution",
          "text": "Correct the polarity, then make a test weld on clean scrap.",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {}
        },
        {
          "id": "porosity-gas",
          "kind": "question",
          "text": "If using MIG, is shielding gas flowing and is the nozzle clean? Skip this gas check for self-shielded flux-core.",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {
            "yes": "porosity-cleanliness",
            "no": "porosity-fix-gas",
            "skip": "porosity-cleanliness"
          }
        },
        {
          "id": "porosity-fix-gas",
          "kind": "resolution",
          "text": "Restore the wire supplier's recommended shielding gas, clean the nozzle, and maintain proper CTWD.",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {}
        },
        {
          "id": "porosity-cleanliness",
          "kind": "check",
          "text": "Clean the workpiece to bare metal and verify the wire has no oil, coating, or residue.",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {
            "clean": "porosity-technique",
            "dirty": "porosity-fix-cleanliness"
          }
        },
        {
          "id": "porosity-fix-cleanliness",
          "kind": "resolution",
          "text": "Clean the workpiece and wire, then repeat the test weld.",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {}
        },
        {
          "id": "porosity-technique",
          "kind": "check",
          "text": "Maintain steady travel speed and reduce excessive contact-tip-to-work distance.",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {
            "resolved": "porosity-resolved",
            "persists": "porosity-escalate"
          }
        },
        {
          "id": "porosity-resolved",
          "kind": "resolution",
          "text": "The source-backed setup and technique checks are complete.",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {}
        },
        {
          "id": "porosity-escalate",
          "kind": "resolution",
          "text": "Stop and inspect consumables, connections, and machine condition before continuing. Seek qualified help if the problem persists.",
          "evidenceIds": [
            "ev-wire-porosity-p37"
          ],
          "next": {}
        }
      ]
    }
