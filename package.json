{
  "name": "omnipro-product-twin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postbuild": "node scripts/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "product:compile": "tsx scripts/compile-product.ts --assets",
    "product:check": "tsx scripts/compile-product.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "npm run product:check && npm run check:model && npm run typecheck && npm test && npm run build",
    "check:model": "tsx scripts/check-omnipro-model.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.235",
    "@upstash/redis": "^1.38.2",
    "gsap": "3.15.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.179.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "20.19.24",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.179.0",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "26.1.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
