ANTHROPIC_API_KEY=your-api-key-here
APP_PASSWORD=choose-a-shared-password
AUTH_SECRET=generate-at-least-32-random-characters

# Required on Vercel production. Provision Upstash for Redis through the
# Vercel Marketplace, which injects these values automatically.
KV_REST_API_URL=https://your-database.upstash.io
KV_REST_API_TOKEN=your-upstash-rest-token

# Optional agent limits. Defaults: 10 turns / 10 minutes per login session,
# plus 60 turns / 24 hours per source address.
AGENT_RATE_LIMIT_MAX=10
AGENT_RATE_LIMIT_WINDOW_SECONDS=600
AGENT_IP_DAILY_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
