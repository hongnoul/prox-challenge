ANTHROPIC_API_KEY=your-api-key-here
APP_PASSWORD=choose-a-shared-password
AUTH_SECRET=generate-at-least-32-random-characters

# Required in production. Provision Neon through the Vercel Marketplace,
# which injects DATABASE_URL automatically. RATE_LIMIT_DATABASE_URL can
# override it when the limiter uses a dedicated Postgres database.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# RATE_LIMIT_DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Optional agent limits. Defaults: 10 turns / 10 minutes per login session,
# plus 60 turns / 24 hours per source address.
AGENT_RATE_LIMIT_MAX=10
AGENT_RATE_LIMIT_WINDOW_SECONDS=600
AGENT_IP_DAILY_LIMIT_MAX=60
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
